# Ignorer les fichiers Python compilés
*.pyc
*.pyo
*.pyd
__pycache__/

# Ignorer les environnements virtuels
venv/
env/
*.env

# Ignorer les fichiers de logs
*.log

# Ignorer les fichiers temporaires ou système
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db

# Ignorer les fichiers de configuration utilisateur
*.vscode/
.idea/
*.iml

# Ignorer les fichiers de tests
Code/tests/passwords.json

# Ignorer les fichiers de diagrammes générés
*.mdj
*.xsd

# Ignorer les fichiers de dépendances ou installateurs
*.egg-info/
dist/
build/

# Ignorer les archives et fichiers binaires
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Ignorer le dossier Git lui-même (au cas où il est inclus par erreur)
.git/